# .htaccess — steelmanufacturer.in (Apache 2.4+ & LiteSpeed)
DirectoryIndex index.html

# ============ 1. Canonical Domain, Protocol & Consolidated 301 Redirects ============
RewriteEngine On

# A. Force HTTPS + non-www in one single 301 redirect hop
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# B. Strip index.php / index.html from URLs
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.(php|html?)[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]

# C. 301 Redirect Core URL Duplicates in One Hop
RewriteRule ^home/?$ https://steelmanufacturer.in/ [L,R=301]
RewriteRule ^marketplace/?$ https://steelmanufacturer.in/market-area/ [L,R=301]
RewriteRule ^about/?$ https://steelmanufacturer.in/about-us/ [L,R=301]
RewriteRule ^delhi/?$ https://steelmanufacturer.in/market-area/delhi/ [L,R=301]
RewriteRule ^bangalore/?$ https://steelmanufacturer.in/market-area/bengaluru/ [L,R=301]

# D. 301 Redirect Legacy City URLs to /market-area/<city>/ (covers pipe/pipes, with or without 'in-')
RewriteRule ^electropolished-pipes?-manufacturer-(?:in-)?([^/]+)/?$ https://steelmanufacturer.in/market-area/$1/ [L,R=301]
RewriteRule ^electropolished-pipes?-supplier-(?:in-)?([^/]+)/?$ https://steelmanufacturer.in/market-area/$1/ [L,R=301]
RewriteRule ^industrial-pipe-flange-manufacturer-in-([^/]+)-sakshi-forge/?$ https://steelmanufacturer.in/market-area/$1/ [L,R=301]

# E. Add trailing slash to non-file URLs in one 301 hop (excluding API routes)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.
RewriteCond %{REQUEST_URI} !^/api
RewriteRule ^(.*)$ https://steelmanufacturer.in/$1/ [L,R=301]

# F. Optional API proxy fallback (if Apache mod_proxy is enabled)
<IfModule mod_proxy.c>
  <IfModule mod_proxy_http.c>
    SSLProxyEngine On
    RewriteRule ^api/(.*)$ https://sakshi-fr.errorr990551.workers.dev/api/$1 [P,L]
  </IfModule>
</IfModule>

# ============ 2. Pre-rendered Directory & Static File Routing ============
# Serve existing physical files directly (images, css, js, robots.txt, sitemaps, etc.)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Serve existing pre-rendered directory index.html
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^ %{REQUEST_FILENAME}/index.html [L]

# ============ 3. Genuinely Unknown URLs Return REAL HTTP 404 (Fixes Soft-404) ============
ErrorDocument 404 /404.html

RewriteCond %{REQUEST_URI} !^/api
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [R=404,L]

# ============ 4. Compression ============
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ============ 5. Browser Caching ============
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
FileETag None

# ============ 6. Security Headers ============
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ============ 7. Block Sensitive Files ============
<FilesMatch "^(\.htaccess|\.env|config\.php|composer\.(json|lock))$">
  Require all denied
</FilesMatch>